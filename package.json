{
  "name": "kindred-studio",
  "version": "2.0.0",
  "description": "Mac-local studio that makes short character videos (ChatGPT prompt, Grok video) and posts them to TikTok and YouTube Shorts by driving a real browser.",
  "main": "server/index.ts",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.client.json",
    "test": "tsx tests/run-all.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "daily": "tsx scripts/dailyRun.ts",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "youtube:test": "tsx scripts/youtubeTest.ts"
  },
  "keywords": [
    "short-video",
    "tiktok",
    "youtube-shorts",
    "playwright",
    "browser-automation",
    "chatgpt",
    "grok-imagine"
  ],
  "author": "Lynqcloudpay",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@jkudish/jev-browser": "^0.8.11",
    "@tailwindcss/vite": "^4.3.5",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
