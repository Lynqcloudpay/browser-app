# KindredStudio settings. Every line is optional: the app runs with none of them set.
# No API keys are needed. The app drives a real browser where you sign in yourself.

# Port for the local API. The web page (Vite, port 5173) proxies /api and /media to it.
# Use SERVER_PORT, not PORT: dev launchers set PORT for the web page.
SERVER_PORT=3000

# Address the API listens on. Keep 127.0.0.1 so only this computer can reach it.
# SERVER_HOST=127.0.0.1

# Where the SQLite database lives (default: storage/kindred_studio.db).
# DATABASE_PATH=./storage/kindred_studio.db
