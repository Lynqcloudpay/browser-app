# KindredStudio Environment Configuration

# Server Port
PORT=3000

# SQLite Database File Path (defaults to storage/kindred_studio.db)
DATABASE_PATH=./storage/kindred_studio.db

# TypeSafe Jev API (System One Decision Model)
# Endpoint defaults to https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# OpenAI API (On-Demand Writing Tool)
# Used exclusively on-demand by Jev for scripts, hooks, and shot prompts
OPENAI_API_KEY=your_openai_api_key_here

# xAI API (Grok Imagine Video Generation)
# Used for rendering vertical 9:16 story shots
XAI_API_KEY=your_xai_api_key_here

# Buffer GraphQL API (TikTok Publication Engine)
# Required for unattended scheduling & publishing to adult-owned TikTok channel
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_CHANNEL_ID=your_tiktok_channel_id_here

